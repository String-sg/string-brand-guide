{
  "name": "@string-sg/ui",
  "version": "0.1.0",
  "description": "Shared String interface components and scoped brand styles",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "5.7.3"
  }
}
